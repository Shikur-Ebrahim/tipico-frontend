# Copy to .env.local for local dev (never commit real secrets).

# Backend API — base URL of your Render (or local) API. May be host-only: https://your-backend.onrender.com
# (the app appends /api automatically). Prefer explicit: https://your-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api

# Cloudinary — browser uploads (deposits, admin logos)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Optional — only if your client code reads it
# CLOUDINARY_API_KEY=
